{
  "name": "ag-skills",
  "version": "0.1.0",
  "description": "Create, test, and validate portable AI agent skills (SKILL.md format)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@12.12.1",
  "devEngines": {
    "packageManager": { "name": "pnpm", "version": "12.12.1", "onFail": "download" }
  },
  "scripts": {
    "new": "node tools/new-skill.mjs",
    "validate": "node tools/validate.mjs",
    "test": "node --test 'tests/*.test.mjs' 'skills/*/tests/*.test.mjs'",
    "check": "pnpm validate && pnpm test",
    "install-skill": "node tools/link.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
