{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://veritasacta.com/schemas/receipt-protect-mcp-0.31.json",
  "title": "protect-mcp decision receipt",
  "description": "Expected shape of a protect-mcp@0.31.1 receipt. Mirrors draft-farley-acta-signed-receipts-03; the signature covers the JCS-canonical payload.",
  "type": "object",
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["type", "tool_name", "decision", "request_id", "issued_at", "public_key", "spec"],
      "properties": {
        "type": { "type": "string", "const": "protectmcp:decision" },
        "tool_name": { "type": "string" },
        "decision": { "type": "string", "enum": ["allow", "deny"] },
        "request_id": { "type": "string" },
        "issued_at": { "type": "string", "format": "date-time" },
        "public_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "spec": { "type": "string" },
        "previousReceiptHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "payload_digest": {
          "type": "object",
          "required": ["input_hash", "input_size", "canonical"],
          "properties": {
            "input_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "input_size": { "type": "integer" },
            "canonical": { "type": "string", "const": "jcs" }
          }
        }
      },
      "additionalProperties": true
    },
    "signature": {
      "type": "object",
      "required": ["alg", "kid", "sig"],
      "properties": {
        "alg": { "type": "string", "const": "EdDSA" },
        "kid": { "type": "string" },
        "sig": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  },
  "additionalProperties": true
}
